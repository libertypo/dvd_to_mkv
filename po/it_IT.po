msgstr "La selezione multipla DVD deve essere preparata di nuovo"

msgid "Copying DVD title {title} ({current}/{total})..."
msgstr "Copia del titolo DVD {title} ({current}/{total})..."

msgid "DVD batch: titles are copied sequentially. Space estimates are per title, not for the whole batch; free space and output paths are checked again for each copy."
msgstr "Selezione multipla DVD: i titoli vengono copiati in sequenza. Le stime dello spazio sono per singolo titolo, non per l'intera selezione; lo spazio libero e i percorsi di destinazione vengono ricontrollati per ogni copia."

msgid "Titles skipped during preparation: {titles}"
msgstr "Titoli saltati durante la preparazione: {titles}"

msgid "Titles skipped during copy preflight (kept in batch): {titles}"
msgstr "Titoli saltati durante i controlli preliminari della copia (mantenuti nella selezione): {titles}"

msgid "Warning: no audio track matched the profile for DVD title {title}; the output will have no audio."
msgstr "Attenzione: nessuna traccia audio del titolo DVD {title} corrisponde al profilo; il file risultante non avrà audio."

msgid "Warning: no audio track was selected for DVD title {title}; the output will have no audio."
msgstr "Attenzione: nessuna traccia audio è stata selezionata per il titolo DVD {title}; il file risultante non avrà audio."

msgid "Warning: no audio track was selected for playlist {playlist}; the output will have no audio."
msgstr "Attenzione: nessuna traccia audio è stata selezionata per la playlist {playlist}; il file risultante non avrà audio."

msgid "Warning: audio selection could not be determined; check whether the output includes audio."
msgstr "Attenzione: non è stato possibile determinare la selezione audio; verificare se il file risultante include audio."

