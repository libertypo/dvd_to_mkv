msgid "Choose output type"
msgstr "Alegeți tipul destinației"

msgid "The output path does not exist and does not end in .mkv or .m2ts:\n{path}\n\nUse it as a file named {resolved}, or choose Directory to create or select an existing directory before retrying."
msgstr "Calea de destinație nu există și nu se termină în .mkv sau .m2ts:\n{path}\n\nFolosiți-o ca fișier cu numele {resolved} sau alegeți Director pentru a crea ori selecta un director existent înainte de a reîncerca."

msgid "Directory"
msgstr "Director"

msgid "Choose an existing output directory"
msgstr "Alegeți un director de destinație existent"

msgid "Use as file"
msgstr "Folosiți ca fișier"

msgid "Use the displayed output filename"
msgstr "Folosiți numele afișat al fișierului de destinație"

msgid "Automatic (sample-based)"
msgstr "Automat (pe baza unui eșantion)"

msgid "Original M2TS (unfiltered output)"
msgstr "M2TS original (ieșire nefiltrată)"

msgid "Copy the playlist output without filtering; 3D preservation is not guaranteed."
msgstr "Copiază ieșirea listei de redare fără filtrare; păstrarea 3D nu este garantată."

msgid "Unfiltered playlist output (M2TS)."
msgstr "Ieșirea nefiltrată a listei de redare (M2TS)."

msgid "Playlist {playlist}: M2TS copies the playlist output without filtering"
msgstr "Lista de redare {playlist}: M2TS copiază ieșirea listei de redare fără filtrare"

msgid "Copy without filtering?"
msgstr "Copiați fără filtrare?"

msgid "Playlist {playlist}: copy unfiltered M2TS output?"
msgstr "Lista de redare {playlist}: copiați ieșirea M2TS nefiltrată?"

msgid "Your filtered selection cannot be applied to M2TS. The playlist output may omit the 3D dependent view."
msgstr "Selecția filtrată nu poate fi aplicată la M2TS. Ieșirea listei de redare poate omite vederea 3D dependentă."

msgid "Warning: MKV and M2TS copies may omit the 3D dependent view; 3D preservation is not verified."
msgstr "Atenție: copiile MKV și M2TS pot omite vederea 3D dependentă; păstrarea 3D nu este verificată."

msgid "Warning: The source is not pinned and may change or be replaced. Use a source protected from changes and keep the same disc inserted."
msgstr "Atenție: sursa nu este fixată și poate fi modificată sau înlocuită. Folosește o sursă protejată împotriva modificărilor și păstrează același disc în unitate."

msgid "M2TS contains the unfiltered playlist output; it may omit a 3D dependent view."
msgstr "M2TS conține ieșirea nefiltrată a listei de redare; poate omite o vedere 3D dependentă."

msgid "Restart to apply the language. Some messages remain in English."
msgstr "Repornește pentru a aplica limba. Unele mesaje rămân în engleză."

msgid "Batch Titles"
msgstr "Titluri multiple"

msgid "Clear Batch"
msgstr "Șterge lotul"

msgid "Discover and select DVD titles to copy sequentially using the active language profile."
msgstr "Descoperă și selectează titlurile DVD de copiat secvențial folosind profilul lingvistic activ."

msgid "Discard the prepared DVD batch."
msgstr "Elimină lotul DVD pregătit."

msgid "DVD batch prepared: {count} title(s)"
msgstr "Lot DVD pregătit: {count} titluri"

msgid "Select DVD Titles"
msgstr "Selectează titlurile DVD"

msgid "Select titles to copy. Each title is inspected separately and uses the active language profile."
msgstr "Selectează titlurile de copiat. Fiecare titlu este analizat separat folosind profilul lingvistic activ."

msgid "Prepare Batch"
msgstr "Pregătește lotul"

msgid "Inspect the selected titles and prepare the batch."
msgstr "Analizează titlurile selectate și pregătește lotul."

msgid "Language profile required"
msgstr "Este necesar un profil lingvistic"

msgid "Choose or create a profile with audio or subtitle languages before preparing a DVD batch."
msgstr "Alege sau creează un profil cu limbi audio sau pentru subtitrări înainte de a pregăti un lot DVD."

msgid "Preparing DVD batch..."
msgstr "Se pregătește lotul DVD..."

msgid "Copying DVD batch..."
msgstr "Se copiază lotul DVD..."

msgid "DVD batch prepared"
msgstr "Lot DVD pregătit"

msgid "DVD batch needs preparation again"
msgstr "Lotul DVD trebuie pregătit din nou"

msgid "Copying DVD title {title} ({current}/{total})..."
msgstr "Se copiază titlul DVD {title} ({current}/{total})..."

msgid "DVD batch: titles are copied sequentially. Space estimates are per title, not for the whole batch; free space and output paths are checked again for each copy."
msgstr "Lot DVD: titlurile sunt copiate secvențial. Spațiul este estimat pentru fiecare titlu, nu pentru întregul lot; spațiul liber și căile de destinație sunt verificate din nou pentru fiecare copiere."

msgid "Titles skipped during preparation: {titles}"
msgstr "Titluri omise la pregătire: {titles}"

msgid "Titles skipped during copy preflight (kept in batch): {titles}"
msgstr "Titluri omise la verificarea preliminară a copierii (păstrate în lot): {titles}"

msgid "Warning: no audio track matched the profile for DVD title {title}; the output will have no audio."
msgstr "Atenție: nicio pistă audio a titlului DVD {title} nu corespunde profilului; fișierul rezultat nu va avea sunet."

msgid "Warning: no audio track was selected for DVD title {title}; the output will have no audio."
msgstr "Atenție: nu a fost selectată nicio pistă audio pentru titlul DVD {title}; fișierul rezultat nu va avea sunet."

msgid "Warning: no audio track was selected for playlist {playlist}; the output will have no audio."
msgstr "Atenție: nu a fost selectată nicio pistă audio pentru lista {playlist}; fișierul rezultat nu va avea sunet."

msgid "Warning: audio selection could not be determined; check whether the output includes audio."
msgstr "Atenție: selecția audio nu a putut fi determinată; verificați dacă fișierul rezultat conține audio."

